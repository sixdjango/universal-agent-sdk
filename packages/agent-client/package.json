{
  "name": "@universal-agent/client",
  "version": "0.1.0",
  "description": "Standalone Universal ACP Agent Client SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "presets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist presets"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex": "^0.160.1",
    "@universal-agent/acp-extension-core": "workspace:*",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "open": "^11.0.1",
    "vscode-jsonrpc": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.3",
    "@universal-agent/acp-extension-claude": "workspace:*",
    "@universal-agent/acp-extension-codex": "workspace:*",
    "@universal-agent/acp-extension-devin": "workspace:*",
    "@universal-agent/acp-extension-dsh": "workspace:*",
    "@universal-agent/acp-extension-grok": "workspace:*",
    "@universal-agent/acp-extension-kimi": "workspace:*",
    "@universal-agent/acp-extension-pi": "workspace:*",
    "rolldown": "^1.2.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
