{
  "name": "@universal-agent/workflow-web",
  "version": "0.1.2",
  "description": "Prebuilt web app for Universal Agent workflows, built from @universal-agent/workflow-ui (served by @universal-agent/workflow-server)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixdjango/universal-agent-sdk.git",
    "directory": "packages/workflow-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@universal-agent/workflow-contract": "workspace:*",
    "@universal-agent/workflow-runtime": "workspace:*",
    "@universal-agent/workflow-ui": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^3.2.4"
  }
}
