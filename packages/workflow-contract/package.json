{
  "name": "@universal-agent/workflow-contract",
  "version": "0.2.0",
  "description": "Hierarchical DAG contract, topological compiler, and pattern builders for Universal Agent Workflow Kit",
  "keywords": [
    "workflow",
    "dag",
    "ai-agents",
    "orchestration",
    "zod",
    "schema"
  ],
  "homepage": "https://github.com/sixdjango/universal-agent-sdk/tree/main/packages/workflow-contract#readme",
  "bugs": {
    "url": "https://github.com/sixdjango/universal-agent-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixdjango/universal-agent-sdk.git",
    "directory": "packages/workflow-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ua-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workflow-package.mjs --platform neutral",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
