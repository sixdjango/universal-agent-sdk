{
  "name": "@universal-agent/acp-extension-core",
  "version": "0.1.2",
  "description": "Core ACP extension protocol contracts and helpers for Universal Agent SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sixdjango/universal-agent-sdk.git",
    "directory": "packages/acp-extension-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "pnpm run build && node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
