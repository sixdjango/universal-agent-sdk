{
  "name": "@universal-agent/acp-extension-core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "pnpm run build && node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
